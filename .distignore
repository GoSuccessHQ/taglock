# Distribution ignore file for wp dist-archive
# These files/folders will not be included in the distribution archive

# Development files
.git
.gitignore
.distignore
.editorconfig
.eslintrc
.prettierrc
.phpcs.xml
phpcs.xml
phpunit.xml
phpstan.neon

# Development dependencies
node_modules
tests
*.test.js
*.test.php

# Build tools
package.json
package-lock.json
composer.json
composer.lock
webpack.config.js
Gruntfile.js
Gulpfile.js

# Source files (compiled versions are in assets/build/)
assets/src

# Documentation
docs
CHANGELOG.md
CONTRIBUTING.md

# IDE files
.idea
.vscode
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
